// Funktion zum Aufteilen einer einzelnen Klasse

function splitClassPolygons(
  featureCollection,
  classNumber,
  randomSeed
) {

  var sortedPolygons = featureCollection
    .filter(ee.Filter.eq('class', classNumber))
    .randomColumn('splitRandom', randomSeed)
    .sort('splitRandom');

  var totalCount = sortedPolygons.size();

  var proposedTrainingCount = totalCount
    .multiply(trainingFraction)
    .floor();

  var maximumTrainingCount = totalCount
    .subtract(minimumValidationPolygons);

  var trainingCount = proposedTrainingCount
    .min(maximumTrainingCount);

  var polygonList = sortedPolygons.toList(totalCount);

  return {
    training: ee.FeatureCollection(
      polygonList.slice(0, trainingCount)
    ),

    validation: ee.FeatureCollection(
      polygonList.slice(trainingCount, totalCount)
    )
  };
}

