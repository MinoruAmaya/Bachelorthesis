// Räumliche 5-Fold-Kreuzvalidierung: RF ohne GLCM, nur 2025
// Verwendet genau den bisherigen begrenzten Trainingspixelpool:
// maximal 1.000 Pixel je Klasse insgesamt, nicht je Fold.
// Die Testfolds stammen NICHT aus den bisherigen Hold-out-Polygonen.
if (runSpatialCV) {
  function cvCountClass(samples, k) {
    return samples.filter(ee.Filter.eq('class', k)).size();
  }
  function cvContainsAllClasses(samples) {
    return cvCountClass(samples, 0).gt(0)
      .and(cvCountClass(samples, 1).gt(0))
      .and(cvCountClass(samples, 2).gt(0));
  }

  var cvColours = ee.List(['1b9e77', 'd95f02', '7570b3', 'e7298a', '66a61e']);
  if (showSpatialCVFolds) {
    var cvStyled = trainingPolygonSet.map(function(f) {
      var colour = ee.String(cvColours.get(ee.Number(f.get('cv_fold'))));
      return f.set('cv_style', {
        color: colour, fillColor: colour.cat('66'), width: 2
      });
    });
    Map.addLayer(cvStyled.style({styleProperty: 'cv_style'}), {},
      'CV: Trainingspolygone nach räumlichem Fold', true);
  }
  // Die Polygontabelle zeigt Block/Fold/Klasse ohne zusätzliche Rasteranalyse.
  print('CV: Polygonzuordnung (Fold 0 bis 4)', trainingPolygonSet.select([
    'class', 'cv_polygon_id', 'cv_block_id', 'cv_fold'
  ]));
  print('CV: belegte Blöcke je Fold', cvAssignedBlocks.aggregate_histogram('cv_fold'));

  var cvRows = [];
  var cvPredictions = ee.FeatureCollection([]);
  for (var cvFold = 0; cvFold < cvNumberOfFolds; cvFold++) {
    var testPolygons = trainingPolygonSet.filter(ee.Filter.eq('cv_fold', cvFold));
    var candidatePolygons = trainingPolygonSet.filter(ee.Filter.neq('cv_fold', cvFold));
    // Entfernt ganze Trainingspolygone in höchstens 1 km Entfernung von
    // einem Testpolygon. Abstand wird zwischen den Polygongeometrien geprüft.
    // Dies erhöht die Trennung, beweist aber keine vollständige Unabhängigkeit.
    var retainedPolygons = ee.FeatureCollection(ee.Join.inverted().apply(
      candidatePolygons, testPolygons,
      ee.Filter.withinDistance({
        distance: cvExclusionDistanceMetres,
        leftField: '.geo', rightField: '.geo', maxError: 1
      })
    ));
    var retainedIDs = retainedPolygons.aggregate_array('cv_polygon_id');
    var foldTraining = trainingSamples.filter(
      ee.Filter.inList('cv_polygon_id', retainedIDs)
    );
    var foldTest = trainingSamples.filter(ee.Filter.eq('cv_fold', cvFold));

   // Alle drei Klassen müssen im Training vorhanden sein.
// Im Test dürfen einzelne Referenzklassen fehlen.
// Voraussetzung bleibt eine nicht leere Teststichprobe.
var valid = cvBlockCount.gte(cvNumberOfFolds)
  .and(cvContainsAllClasses(foldTraining))
  .and(foldTest.size().gt(0));
    var foldModel = ee.Classifier.smileRandomForest({
      numberOfTrees: 200, variablesPerSplit: null,
      minLeafPopulation: 2, bagFraction: 0.7, seed: seed
    }).train({
      features: foldTraining, classProperty: 'class', inputProperties: selectedBands
    });
    var predicted = ee.FeatureCollection(ee.Algorithms.If(
      valid, foldTest.classify(foldModel, 'cv_prediction'), ee.FeatureCollection([])
    ));
    var matrix = predicted.errorMatrix('class', 'cv_prediction', [0, 1, 2]);
    var rowProperties = {
      fold: cvFold,
      status: ee.Algorithms.If(valid,'OK','INVALID: Trainingsklassen, Testpixelzahl oder Blockzahl prüfen'),
      training_polygons: retainedPolygons.size(),
      excluded_training_polygons: candidatePolygons.size().subtract(retainedPolygons.size()),
      test_polygons: testPolygons.size(),
      training_pixels: foldTraining.size(), test_pixels: foldTest.size(),
      training_class_0: cvCountClass(foldTraining, 0),
      training_class_1: cvCountClass(foldTraining, 1),
      training_class_2: cvCountClass(foldTraining, 2),
      test_class_0: cvCountClass(foldTest, 0),
      test_class_1: cvCountClass(foldTest, 1),
      test_class_2: cvCountClass(foldTest, 2),
      overall_accuracy: ee.Algorithms.If(valid, matrix.accuracy(), null),
      kappa: ee.Algorithms.If(valid, matrix.kappa(), null)
    };
    // Neun skalare Felder statt verschachtelter Matrix in der Ergebnistabelle.
    for (var r = 0; r < 3; r++) {
      for (var c = 0; c < 3; c++) {
        rowProperties['cm_' + r + '_' + c] = ee.Algorithms.If(
          valid, matrix.array().get([r, c]), null
        );
      }
    }
    cvRows.push(ee.Feature(null, rowProperties));
    cvPredictions = cvPredictions.merge(predicted);
  }
  var cvResults = ee.FeatureCollection(cvRows);
  var cvValidResults = cvResults.filter(ee.Filter.eq('status', 'OK'));
  var cvValidCount = cvValidResults.size();
  var cvPooledMatrix = cvPredictions.errorMatrix('class', 'cv_prediction', [0, 1, 2]);

  // Eine gemeinsame Ausgabe reduziert gleichzeitig gestartete Auswertungen.
  print('RF räumliche CV: Ergebnisse und Zusammenfassung', ee.Dictionary({
    requested_folds: cvNumberOfFolds,
    valid_folds: cvValidCount,
    interpretation: ee.Algorithms.If(cvValidCount.eq(cvNumberOfFolds),
      'Alle 5 Folds gültig; räumliche Aufteilung dennoch visuell prüfen.',
      'Keine vollständige 5-Fold-Bewertung: INVALID-Folds prüfen.'),
    block_size_m: cvBlockSizeMetres,
    exclusion_distance_m: cvExclusionDistanceMetres,
    sample_pool_pixels: trainingSamples.size(),
    fold_results: cvResults.toList(cvNumberOfFolds).map(function(item) {
  return ee.Feature(item).toDictionary();
}),
    oa_mean: ee.Algorithms.If(cvValidCount.gt(0),
      cvValidResults.aggregate_mean('overall_accuracy'), null),
    oa_sample_sd: ee.Algorithms.If(cvValidCount.gt(1),
      cvValidResults.aggregate_sample_sd('overall_accuracy'), null),
    kappa_mean: ee.Algorithms.If(cvValidCount.gt(0),
      cvValidResults.aggregate_mean('kappa'), null),
    kappa_sample_sd: ee.Algorithms.If(cvValidCount.gt(1),
      cvValidResults.aggregate_sample_sd('kappa'), null),
    pooled_confusion_matrix: ee.Algorithms.If(cvValidCount.gt(0),
      cvPooledMatrix.array(), null),
    pooled_oa: ee.Algorithms.If(cvValidCount.gt(0), cvPooledMatrix.accuracy(), null),
    pooled_kappa: ee.Algorithms.If(cvValidCount.gt(0), cvPooledMatrix.kappa(), null)
  }));
}
