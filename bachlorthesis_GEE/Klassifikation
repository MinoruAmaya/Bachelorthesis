//Wolkenmaskierung
function maskS2(image){
 // Scene Classification Layer auswählen.
  var scl = image.select('SCL');


  // Wolken, Wolkenschatten, Cirrus sowie Schnee entfernen.
  //
   // Entfernt:
  // 0  = keine Daten
  // 1  = gesättigte / defekte Pixel
  // 3  = Wolkenschatten
  // 8  = Wolken mittlerer Wahrscheinlichkeit
  // 9  = Wolken hoher Wahrscheinlichkeit
  // 10 = Cirrus
  // 11 = Schnee / Eis
  // 1 = gesättigte oder defekte Pixel
  var mask = scl
    .neq(0)
    .and(scl.neq(1))
    .and(scl.neq(3))
    .and(scl.neq(8))
    .and(scl.neq(9))
    .and(scl.neq(10))
    .and(scl.neq(11));


  // Benötigte Sentinel-2-Bänder auswählen
  // und auf Reflexionswerte von ungefähr 0 bis 1 skalieren.
var reflectance = image
    .select([
      'B2', 'B3', 'B4', 'B5', 'B6',
      'B7', 'B8', 'B8A', 'B11', 'B12'
    ])
    .multiply(0.0001)
    .updateMask(mask);


  // NDVI: Vegetationsaktivität.
  var ndvi = reflectance
    .normalizedDifference([
      'B8',
      'B4'
    ])
    .rename('NDVI');


  // NDMI: Feuchtigkeit von Vegetation und Boden.
  var ndmi = reflectance
    .normalizedDifference([
      'B8',
      'B11'
    ])
    .rename('NDMI');


  // NDRE: Red-Edge-Vegetationsindex.
  var ndre = reflectance
    .normalizedDifference([
      'B8A',
      'B5'
    ])
    .rename('NDRE');


  // Bare Soil Index.
  var bsi = reflectance.expression(
    '((swir + red) - (nir + blue)) / ' +
    '((swir + red) + (nir + blue))',
    {
      swir: reflectance.select('B11'),
      red: reflectance.select('B4'),
      nir: reflectance.select('B8'),
      blue: reflectance.select('B2')
    }
  ).rename('BSI');


  return reflectance
    .addBands([
      ndvi,
      ndmi,
      ndre,
      bsi
    ])
    .copyProperties(
      image,
      ['system:time_start']
    );
}


