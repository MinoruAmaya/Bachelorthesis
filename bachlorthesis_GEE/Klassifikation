if (runSpatialCV) {
  var cvProjection = ee.Projection(cvGridCRS);
  trainingPolygonSet = trainingPolygonSet.map(function(f) {
    var xy = f.geometry().centroid(1).transform(cvProjection, 1).coordinates();
    var bx = ee.Number(xy.get(0)).divide(cvBlockSizeMetres).floor();
    var by = ee.Number(xy.get(1)).divide(cvBlockSizeMetres).floor();
    var id = bx.format('%d').cat('_').cat(by.format('%d'));
    return f.set({
      cv_polygon_id: ee.Number(f.get('class')).format('%d')
        .cat('_').cat(ee.String(f.get('system:index'))),
      cv_block_id: id,
      cv_block_x: bx,
      cv_block_y: by
    });
  });

  // Ganze belegte Blöcke zufällig sortieren und reihum fünf Folds zuweisen.
  // Kein Suchen nach einer Aufteilung mit besonders günstiger Genauigkeit.
  var cvBlocks = trainingPolygonSet.distinct(['cv_block_id'])
    .randomColumn('cv_block_random', seed, 'uniform', ['cv_block_id'])
    .sort('cv_block_random');
  var cvBlockCount = cvBlocks.size();
  var cvBlockList = cvBlocks.toList(cvBlockCount);
  var cvAssignedBlocks = ee.FeatureCollection(
    ee.List.sequence(0, cvBlockCount.subtract(1)).map(function(i) {
      i = ee.Number(i);
      return ee.Feature(cvBlockList.get(i)).set('cv_fold', i.mod(cvNumberOfFolds));
    })
  );
  var cvFoldLookup = ee.Dictionary.fromLists(
    cvAssignedBlocks.aggregate_array('cv_block_id'),
    cvAssignedBlocks.aggregate_array('cv_fold')
  );
  trainingPolygonSet = trainingPolygonSet.map(function(f) {
    return f.set('cv_fold', cvFoldLookup.get(ee.String(f.get('cv_block_id'))));
  });
}

