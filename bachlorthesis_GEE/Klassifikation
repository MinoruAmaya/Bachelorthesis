// Feature Importance
// explain() liefert Informationen zum trainierten RF.
//
// Die Importance-Prozentwerte werden relativ zur Summe
// aller Wichtigkeitswerte des jeweiligen Modells berechnet.
//
// Sie sind KEINE prozentualen Beiträge zur OA.
// Sie ersetzen weder Hold-out noch Kreuzvalidierung.
// Keine Tabellenexporte.

function showRFImportance(classifier, modelName) {

  var importance = ee.Dictionary(
    classifier.explain().get('importance')
  );

  var totalImportance = ee.Number(
    importance.values().reduce(ee.Reducer.sum())
  );

  var importanceTable = ee.FeatureCollection(
    importance.keys().map(function(band) {

      band = ee.String(band);

      var value = ee.Number(
        importance.get(band)
      );

      var percentage = ee.Algorithms.If(
        totalImportance.gt(0),
        value
          .divide(totalImportance.max(1e-30))
          .multiply(100),
        0
      );

      return ee.Feature(null, {
        model: modelName,
        predictor: band,
        importance: value,
        importance_percent: percentage
      });
    })
  ).sort('importance', false);

  print(
    modelName + ': Feature Importance sortiert',
    importanceTable
  );
}

