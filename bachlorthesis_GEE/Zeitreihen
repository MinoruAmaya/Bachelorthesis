// monatliche S2-Komposite erstellen, und die Werte im Buffer zusammenfassen, und auch als CSV Export für spätere Kontrolle mit R


var startDate = '2018-01-01';
var endDate   = '2026-01-01';   

// Sentinel-2 wird nur für die Stichproben- und Kontrollflächen geladen,
// um den Rechenaufwand zu reduzieren.
var processingAreas = sampleAreas
  .merge(desertControlArea);
  
  
  
  
var s2 = ee.ImageCollection(
  'COPERNICUS/S2_SR_HARMONIZED'
)
.filterBounds(processingAreas.geometry())
.filterDate(startDate, endDate)
.filter(
  ee.Filter.lt(
    'CLOUDY_PIXEL_PERCENTAGE',
    40
  )
);


function prepareSentinel2(image) {

  var scl = image.select('SCL');

  var validMask = scl
    .neq(0)                 // No Data
    .and(scl.neq(1))        // defekte/gesättigte Pixel
    .and(scl.neq(3))        // Wolkenschatten
    .and(scl.neq(8))        // Wolken
    .and(scl.neq(9))        // Wolken
    .and(scl.neq(10))       // Cirrus
    .and(scl.neq(11));      // Schnee/Eis


  var reflectance = image
    .select([
      'B2',
      'B3',
      'B4',
      'B5',
      'B6',
      'B7',
      'B8',
      'B8A',
      'B11',
      'B12'
    ])
    .multiply(0.0001)
    .updateMask(validMask);


  var ndvi = reflectance
    .normalizedDifference([
      'B8',
      'B4'
    ])
    .rename('NDVI');


  var ndre = reflectance
    .normalizedDifference([
      'B8A',
      'B5'
    ])
    .rename('NDRE');


  var ndmi = reflectance
    .normalizedDifference([
      'B8',
      'B11'
    ])
    .rename('NDMI');


  var ndwi = reflectance
    .normalizedDifference([
      'B3',
      'B8'
    ])
    .rename('NDWI');


  var bsi = reflectance.expression(
    '((SWIR + RED) - (NIR + BLUE)) / ' +
    '((SWIR + RED) + (NIR + BLUE))',
    {
      SWIR: reflectance.select('B11'),
      RED: reflectance.select('B4'),
      NIR: reflectance.select('B8'),
      BLUE: reflectance.select('B2')
    }
  ).rename('BSI');


  return reflectance
    .addBands([
      ndvi,
      ndre,
      ndmi,
      ndwi,
      bsi
    ])
    .copyProperties(
      image,
      ['system:time_start']
    );
}


var prepared = s2.map(
  prepareSentinel2
);

// Monatliche Zeitreihe
var numberOfMonths = ee.Date(endDate)
  .difference(
    ee.Date(startDate),
    'month'
  )
  .toInt();


var monthNumbers = ee.List.sequence(
  0,
  numberOfMonths.subtract(1)
);


var monthlyTables = monthNumbers.map(function(monthNumber) {

  monthNumber = ee.Number(monthNumber);


  var monthStart = ee.Date(startDate)
    .advance(
      monthNumber,
      'month'
    );

  var monthEnd = monthStart.advance(
    1,
    'month'
  );


  // Alle vorbereiteten Aufnahmen dieses einzelnen Monats
  var imagesInMonth = prepared.filterDate(
    monthStart,
    monthEnd
  );


  // Zeitlicher Median dieses Monats
  var monthlyMedian = imagesInMonth
    .select([
      'NDVI',
      'NDRE',
      'NDMI',
      'NDWI',
      'BSI'
    ])
    .median();
// Anzahl gültiger NDVI-Beobachtungen je Pixel
// nach der SCL-Maskierung.
// Beim späteren reduceRegions() wird daraus der Median
// der Beobachtungsanzahl innerhalb des jeweiligen Buffers.
  var observationCount = imagesInMonth
    .select('NDVI')
    .count()
    .rename('observation_count');
  
  
  // Dem Monatskomposit hinzufügen
  monthlyMedian = monthlyMedian
    .addBands(observationCount);

  // Räumlicher Median innerhalb der 9 Buffer
  var bufferStatistics = monthlyMedian.reduceRegions({
    collection: sampleAreas,
    reducer: ee.Reducer.median(),
    scale: 20
  });


  // Monat + Anzahl verwendeter S2-Bilder mitgeben
  return bufferStatistics.map(function(feature) {

    return ee.Feature(feature).set({
      date: monthStart.format('YYYY-MM'),
      year: monthStart.get('year'),
      month: monthStart.get('month'),
      image_count: imagesInMonth.size()
    });

  });

});

var timeSeries = ee.FeatureCollection(
  monthlyTables
).flatten();

