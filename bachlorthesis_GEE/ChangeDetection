// Qualitätsmaskierung und Indexberechnung
function maskS2(image) {

  var scl = image.select('SCL');

  // Bisherige SCL-Maskierung unverändert.
  var valid = scl
    .neq(0)
    .and(scl.neq(1))
    .and(scl.neq(3))
    .and(scl.neq(8))
    .and(scl.neq(9))
    .and(scl.neq(10))
    .and(scl.neq(11));

  // Gespeicherte Werte in Oberflächenreflexion umrechnen.
  // Dies ist keine Standardisierung der Modellprädiktoren.
  var r = image
    .select(spectralBands)
    .multiply(0.0001)
    .updateMask(valid);

  var ndvi = r
    .normalizedDifference(['B8', 'B4'])
    .rename('NDVI');

  var ndmi = r
    .normalizedDifference(['B8', 'B11'])
    .rename('NDMI');

  var ndre = r
    .normalizedDifference(['B8A', 'B5'])
    .rename('NDRE');

  var bsi = r.expression(
    '((swir + red) - (nir + blue)) / ' +
    '((swir + red) + (nir + blue))',
    {
      swir: r.select('B11'),
      red: r.select('B4'),
      nir: r.select('B8'),
      blue: r.select('B2')
    }
  ).rename('BSI');

  return r
    .addBands([ndvi, ndmi, ndre, bsi])
    .copyProperties(image, ['system:time_start']);
}




// Sentinel-2-Beobachtungen eines Kalenderjahres
function getCleanYear(year, region) {

  var start = ee.Date.fromYMD(year, 1, 1);

  // Das Enddatum ist exklusiv:
  // 1. Januar bis 1. Januar des Folgejahres.
  return ee.ImageCollection(
    'COPERNICUS/S2_SR_HARMONIZED'
  )
    .filterBounds(region)
    .filterDate(start, start.advance(1, 'year'))
    .filter(
      ee.Filter.lt(
        'CLOUDY_PIXEL_PERCENTAGE',
        maxCloudPercentage
      )
    )
    .map(maskS2);
}





// Jahresprädiktoren berechnen
function buildPredictors(collection, region) {

  // Median ausschließlich für benötigte Bänder und Indizes.
  var median = collection
    .select(medianBands)
    .median();

  median = median.rename(
    medianBands.map(function(name) {
      return name + '_median';
    })
  );

  // Maximum und zeitliche Standardabweichung nur für NDVI.
  var ndviCollection = collection.select('NDVI');

  var maximum = ndviCollection
    .max()
    .rename('NDVI_max');

  var stdDev = ndviCollection
    .reduce(ee.Reducer.stdDev())
    .rename('NDVI_stdDev');

  return median
    .addBands(maximum)
    .addBands(stdDev)
    .select(selectedBands)
    .toFloat()
    .clip(region);
}


// Trainingsbild 2025 für das gesamte geometry
var clean2025 = getCleanYear(trainingYear, projectArea);

var classificationImage = buildPredictors(
  clean2025,
  projectArea
);

print(
  'Sentinel-2-Szenen 2025 für das Trainingsgebiet:',
  clean2025.size()
);

// Referenzgitter eines nativen 10-m-B4-Bandes.
// CRS und Rastertransformation werden für alle Exporte übernommen.
var referenceProjection = ee.Image(clean2025.first())
  .select('B4')
  .projection();

var exportGrid = referenceProjection.getInfo();




// Referenzpolygone zusammenführen
var referencePolygons = desert
  .map(function(f) {
    return f.set('class', 0);
  })
  .merge(
    pivot.map(function(f) {
      return f.set('class', 1);
    })
  )
  .merge(
    agriculture.map(function(f) {
      return f.set('class', 2);
    })
  );




// Hold-Out-Aufteilung auf Ebene der Polygone
function splitClassPolygons(
  collection,
  classNumber,
  randomSeed
) {

  var sorted = collection
    .filter(ee.Filter.eq('class', classNumber))
    .randomColumn('splitRandom', randomSeed)
    .sort('splitRandom');

  var count = sorted.size();

  // Voraussetzung: mindestens sechs Polygone je Klasse.
  var trainingCount = count
    .multiply(trainingFraction)
    .floor()
    .min(count.subtract(minimumValidationPolygons));

  var list = sorted.toList(count);

  return {
    training: ee.FeatureCollection(
      list.slice(0, trainingCount)
    ),
    validation: ee.FeatureCollection(
      list.slice(trainingCount, count)
    )
  };
}

var desertSplit = splitClassPolygons(
  referencePolygons, 0, seed
);

var pivotSplit = splitClassPolygons(
  referencePolygons, 1, seed + 1
);

var agricultureSplit = splitClassPolygons(
  referencePolygons, 2, seed + 2
);

var trainingPolygons = desertSplit.training
  .merge(pivotSplit.training)
  .merge(agricultureSplit.training);

var validationPolygons = desertSplit.validation
  .merge(pivotSplit.validation)
  .merge(agricultureSplit.validation);

print(
  'Referenzpolygone je Klasse – mindestens 6 erforderlich:',
  referencePolygons.aggregate_histogram('class')
);






// Pixelstichproben  erzeugen und begrenzen
function samplePolygons(polygons) {

  return classificationImage.sampleRegions({
    collection: polygons,
    properties: ['class'],
    scale: analysisScale,
    geometries: false,
    tileScale: 16
  });
}

function limitSamples(
  samples,
  classNumber,
  maximum,
  randomSeed
) {

  return samples
    .filter(ee.Filter.eq('class', classNumber))
    .randomColumn('randomSelection', randomSeed)
    .sort('randomSelection')
    .limit(maximum);
}

function balanceSamples(samples, maximum, firstSeed) {

  return limitSamples(samples, 0, maximum, firstSeed)
    .merge(
      limitSamples(samples, 1, maximum, firstSeed + 1)
    )
    .merge(
      limitSamples(samples, 2, maximum, firstSeed + 2)
    );
}

var trainingSamples = balanceSamples(
  samplePolygons(trainingPolygons),
  maxTrainingPixelsPerClass,
  seed + 10
);

var validationSamples = balanceSamples(
  samplePolygons(validationPolygons),
  maxValidationPixelsPerClass,
  seed + 20
);

print(
  'Verwendete Trainingspixel je Klasse:',
  trainingSamples.aggregate_histogram('class')
);

print(
  'Verwendete Validierungspixel je Klasse:',
  validationSamples.aggregate_histogram('class')
);




// RF mit Daten von 2025 trainieren
// Modelleinstellungen unverändert.
// Dasselbe trainierte Modell wird auf sämtliche Jahre angewendet.
var rfClassifier = ee.Classifier.smileRandomForest({
  numberOfTrees: 200,
  variablesPerSplit: null,
  minLeafPopulation: 2,
  bagFraction: 0.7,
  seed: seed
}).train({
  features: trainingSamples,
  classProperty: 'class',
  inputProperties: selectedBands
});





// Hold-Out-Validierung ausschliesslich für 2025
var rfMatrix = validationSamples
  .classify(rfClassifier, 'prediction')
  .errorMatrix('class', 'prediction', [0, 1, 2]);

print('RF Konfusionsmatrix – Validierung 2025:', rfMatrix);
print('RF OA – Validierung 2025:', rfMatrix.accuracy());
print('RF Kappa – Validierung 2025:', rfMatrix.kappa());



// Diese Werte validieren weder die früheren Jahreskarten
// noch die daraus abgeleiteten Veränderungen.

if (showFeatureImportance) {
  print(
    'RF Feature Importance:',
    rfClassifier.explain().get('importance')
  );
}


// 12. RF ausschließlich auf geometry2 anwenden
function classifyYear(year) {

  var predictors;

  if (year === trainingYear) {

    // Bereits vorbereitetes 2025-Bild wiederverwenden.
// Trainingsbild selbst bleibt auf dem gesamten geometry erhalten.
    predictors = classificationImage.clip(analysisRegion);

  } else {

    // Für die früheren Jahre nur Szenen berücksichtigen,
// die den Ausschnitt geometry2 überdecken.
    var collection = getCleanYear(
      year,
      analysisRegion
    );

    print(
      'Sentinel-2-Szenen für geometry2 ' + year + ':',
      collection.size()
    );

    predictors = buildPredictors(
      collection,
      analysisRegion
    );
  }

  // Schon vor der Modellanwendung auf den Ausschnitt begrenzen.
  predictors = predictors
    .clip(analysisRegion)
    .setDefaultProjection(referenceProjection);

  var valid = predictors
    .mask()
    .reduce(ee.Reducer.min());

  return predictors
    .classify(rfClassifier)
    .rename('classification')
    .updateMask(valid)
    .toByte()
    .clip(analysisRegion)
    .setDefaultProjection(referenceProjection)
    .set({
      year: year,
      training_year: trainingYear
    });
}




// Jahresklassifikationen exportieren
function exportImage(image, filename) {

  Export.image.toDrive({
    image: image
      .clip(analysisRegion)
      .toByte()
      .unmask(255, false),

    description: filename,
    fileNamePrefix: filename,
    folder: exportFolder,

    // Entscheidend: Exportregion ist der kleine Ausschnitt.
    region: analysisRegion,

    crs: exportGrid.crs,
    crsTransform: exportGrid.transform,

    maxPixels: 1e13,
    fileFormat: 'GeoTIFF',

    formatOptions: {
      cloudOptimized: true,
      noData: 255
    }
  });
}




// Jahreskarten erzeugen
var annual = {};

for (var year = firstYear; year <= lastYear; year++) {

  annual[year] = classifyYear(year);

  if (exportAnnualMaps) {
    exportImage(
      annual[year],
      'NewDelta_geometry2_RF_Classification_' + year
    );
  }

  if (showPreview && year >= lastYear - 1) {
    Map.addLayer(
      annual[year],
      classVis,
      'RF geometry2: ' + year,
      false
    );
  }
}
